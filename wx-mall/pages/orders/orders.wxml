<view class="orders">
  <view class="head">
    <text class="title">我的订单</text>
    <text class="hint">下拉刷新</text>
  </view>

  <block wx:if="{{rows.length}}">
    <view class="card order" wx:for="{{rows}}" wx:key="id">
      <view class="o-top">
        <text class="o-time">{{item.orderTime}}</text>
        <text class="o-status s{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="o-dishes">{{item.orderDishes}}</view>
      <view class="o-foot">
        <text class="o-no">订单号 {{item.number}}</text>
        <text class="o-amount">¥{{item.amountText}}</text>
      </view>
      <view class="o-actions">
        <text class="act" data-id="{{item.id}}" bindtap="detail">详情</text>
        <text
          class="act warn"
          wx:if="{{item.status === 2}}"
          data-id="{{item.id}}"
          bindtap="cancel"
        >取消订单</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <text>还没有订单，去点一份招牌菜吧</text>
    <button class="btn-ghost back" bindtap="goMenu">去点餐</button>
  </view>
</view>
