.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 店铺头 */
.shop {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx 34rpx;
  background: linear-gradient(135deg, #ff7a3d, #f2480c);
  color: #fff;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
.logo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
}
.shop-name { font-size: 36rpx; font-weight: 800; letter-spacing: 1rpx; }
.shop-tags { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; }
.tag {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}
.tag-light { font-size: 22rpx; opacity: 0.85; }

/* 主体 */
.body {
  flex: 1;
  display: flex;
  min-height: 0;
}
.cats {
  width: 176rpx;
  background: #f7f8fa;
  height: 100%;
}
.cat {
  padding: 30rpx 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.4;
}
.cat-on {
  background: #fff;
  color: #1f2430;
  font-weight: 800;
  border-left: 8rpx solid #ff6b35;
}

.goods {
  flex: 1;
  background: #fff;
  height: 100%;
  padding-bottom: 160rpx;
}
.goods-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx;
}
.goods-title { font-size: 28rpx; font-weight: 800; }
.goods-count { font-size: 22rpx; color: #9ca3af; }

.dish {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f4f5f7;
}
.dish-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 20rpx;
  background: #fff2ec;
  color: #e25420;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: none;
}
.dish-pic { width: 100%; height: 100%; }
.dish-char { font-size: 44rpx; font-weight: 800; }
.dish-main { flex: 1; min-width: 0; }
.dish-name { font-size: 30rpx; font-weight: 700; }
.dish-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.dish-price { color: #ff6b35; font-weight: 800; font-size: 32rpx; }
.yuan { font-size: 22rpx; margin-right: 2rpx; }
.stepper { display: flex; align-items: center; gap: 14rpx; }
.step {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
.plus { background: #ff6b35; color: #fff; }
.minus { border: 1rpx solid #ff6b35; color: #ff6b35; }
.num { font-size: 26rpx; font-weight: 700; }

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #b6bac2;
  font-size: 26rpx;
}

/* 结算条 */
.cartbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 28rpx;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
}
.cart-left { display: flex; align-items: center; gap: 18rpx; }
.cart-icon {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #1f2430;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-amount { font-size: 34rpx; font-weight: 800; }
.cart-hint { font-size: 20rpx; color: #9ca3af; }
.go {
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
  padding: 0 44rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
}
.go[disabled] { background: #cfd3d8; color: #fff; }
