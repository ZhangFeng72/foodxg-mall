.cart { padding-bottom: 200rpx; }
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx 10rpx;
}
.title { font-size: 36rpx; font-weight: 800; }
.clean { font-size: 26rpx; color: #9ca3af; }

.row { display: flex; gap: 20rpx; }
.thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  background: #fff2ec;
  color: #e25420;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: none;
}
.thumb-pic { width: 100%; height: 100%; }
.thumb-char { font-size: 40rpx; font-weight: 800; }
.main { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: 700; }
.flavor { font-size: 22rpx; color: #9ca3af; margin-top: 6rpx; }
.foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.price { color: #ff6b35; font-weight: 800; font-size: 30rpx; }
.stepper { display: flex; align-items: center; gap: 14rpx; }
.step {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
.plus { background: #ff6b35; color: #fff; }
.minus { border: 1rpx solid #ff6b35; color: #ff6b35; }
.num { font-size: 26rpx; font-weight: 700; }

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
}
.sum-label { font-size: 22rpx; color: #9ca3af; }
.sum { font-size: 36rpx; font-weight: 800; }
.go {
  margin: 0;
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
  padding: 0 40rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.empty { padding-top: 180rpx; text-align: center; }
.empty text { color: #9ca3af; font-size: 26rpx; }
.back { margin-top: 40rpx; width: 300rpx; }
