page {
  background: #f4f5f7;
  color: #1f2430;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.muted { color: #8a8f99; }
.brand { color: #ff6b35; }
.price { color: #ff6b35; font-weight: 800; }

.btn-primary {
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
  font-weight: 700;
  line-height: 88rpx;
  font-size: 30rpx;
  border: none;
}
.btn-primary[disabled] { background: #cfd3d8; color: #fff; }

.btn-ghost {
  background: #fff;
  color: #4b5563;
  border: 1rpx solid #eceef2;
  border-radius: 40rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
.btn-ghost::after { border: none; }
